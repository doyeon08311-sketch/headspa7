# Firebase 설정 (로그인 · 회원가입)
# 이 파일을 복사해 .env.local 로 이름을 바꾸고, Firebase 콘솔 > 프로젝트 설정 > 내 앱 의
# firebaseConfig 값을 아래에 채우세요. 비워 두면 사이트는 연습용 로그인으로 동작합니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 토스페이먼츠 (API 개별 연동 키). 비워 두면 결제 없이 주문 완료(연습용)
VITE_TOSS_CLIENT_KEY=
# 시크릿 키는 서버에서만 사용 — VITE_ 를 붙이지 마세요
TOSS_SECRET_KEY=
