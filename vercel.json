{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/confirm.js": { "includeFiles": "src/data/products.json" }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
